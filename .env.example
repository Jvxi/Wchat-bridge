# Required: Claude API key
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: API base URL (for third-party proxies)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: Claude model (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: max conversation history per user (default: 50)
MAX_HISTORY_LENGTH=50

# Optional: Speech recognition (ASR) settings
# ASR_API_URL=https://api.xiaomimimo.com/v1/chat/completions
# ASR_MODEL=mimo-v2.5-asr
# ASR_ENABLED=true

# Optional: Data storage directory (default: ./data)
# DATA_DIR=./data